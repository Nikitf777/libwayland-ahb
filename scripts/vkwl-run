#!/bin/sh
# Run an executable with the Vulkan driver wrapper first in LD_LIBRARY_PATH.
#
# The wrapper is a replacement libvulkan.so/libvulkan.so.1, so any program
# that links or dlopen()s Vulkan will find it before the system loader.
#
# Example:
#   scripts/vkwl-run vulkaninfo --summary
#   VKWL_LOG=1 scripts/vkwl-run vkcube --c 10
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
lib="$root/zig-out/lib/libvkwl.so"
runtime="$root/runtime"

if [ ! -f "$lib" ]; then
    echo "missing $lib; run 'zig build' first" >&2
    exit 1
fi
if [ "$#" -eq 0 ]; then
    echo "usage: $0 <command> [args...]" >&2
    exit 2
fi

mkdir -p "$runtime"
ln -sf "$lib" "$runtime/libvulkan.so"
ln -sf "$lib" "$runtime/libvulkan.so.1"

LD_LIBRARY_PATH="$runtime${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH

exec "$@"
